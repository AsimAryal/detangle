# Detangle
# Copy this file to .env and replace every value marked CHANGE_ME.

# Private Demucster API on your LAN. Do not expose this URL publicly.
DEMUCSTER_URL=http://192.168.50.93:9841

# First-start administrator. These values create the account only when the
# database has no users; later edits do not overwrite its password.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME
INITIAL_ADMIN_DISPLAY_NAME=Administrator

# Persistent application state inside the container.
DATABASE_URL=sqlite+aiosqlite:////data/detangle.db
DATA_DIR=/data
DEFAULT_RETENTION_DAYS=30
DELETE_REMOTE_AFTER_ARCHIVE=true
MAX_UPLOAD_MB=500

# Sessions and public access.
# Leave false for plain HTTP on your LAN. Set true when your tunnel serves HTTPS.
COOKIE_SECURE=false
SESSION_COOKIE_NAME=detangle_session
SESSION_DAYS=14

# Comma-separated public hostnames/IPs accepted by the app. "*" is convenient
# for first setup; replace it after assigning a stable LAN/tunnel hostname.
TRUSTED_HOSTS=*

# Background synchronization.
POLL_INTERVAL_SECONDS=3
ARCHIVE_CONCURRENCY=2
RETENTION_SWEEP_MINUTES=30
LOG_LEVEL=INFO

# Production frontend location in the image.
FRONTEND_DIR=/app/frontend

